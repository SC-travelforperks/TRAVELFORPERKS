# Notion Integration
# Get your integration token from https://www.notion.so/my-integrations
NOTION_TOKEN=ntn_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Notion Database IDs
# Create three databases and share them with your integration
# Copy the database ID from the URL: notion.so/<workspace>/<DATABASE_ID>?v=...
NOTION_DEALS_DATABASE_ID=
NOTION_REVIEWS_DATABASE_ID=
NOTION_GALLERY_DATABASE_ID=

# Revalidation webhook secret (any random string)
REVALIDATE_SECRET=your-random-secret-here

# Resend email delivery for enquiries
RESEND_API_KEY=re_xxxxxxxxx
CLIENT_EMAIL=you@example.com
FROM_EMAIL=enquiries@yourdomain.com

# Floating contact button
NEXT_PUBLIC_WHATSAPP_NUMBER=919867643793
